# CarapaBox Configuration

# HTTP server port (for --http mode)
MCP_SANDBOX_PORT=3100

# HTTP bind address (default 127.0.0.1). Host mode needs 0.0.0.0 (or the
# docker bridge IP) so api-relay can reach host.docker.internal:3100.
# Any non-loopback bind requires CARAPA_BOX_API_TOKEN; Box refuses to start otherwise.
# The containerised compose sets 0.0.0.0 inside the container; restrict the
# host-side publication with MCP_SANDBOX_PUBLISH_HOST instead.
# MCP_SANDBOX_HOST=127.0.0.1
# MCP_SANDBOX_PUBLISH_HOST=0.0.0.0

# Stacks directory (default: ./stacks)
SANDBOX_STACKS_DIR=

# ── Containerised mode ───────────────────────────────────────────────────
# Set these when running carapa-box in a container (docker compose up).
# When unset, carapa-box runs in host mode (bun run start:http).
#
# Both modes use the same api-relay path — no relay-clients changes needed:
#   bot → api-relay:8080/sandbox-relay → host.docker.internal:3100
#
# To switch to host debug mode: docker compose down && bun run dev:http

# Absolute host path of this project — required for containerised mode.
# STACK_DIR in compose files must resolve on the host (Docker daemon side).
SANDBOX_HOST_DIR=
AUDIT_LOG_PATH=

# Compose runtime identity (also used for writable tmpfs ownership).
# Match the owner of generated output/audit and PROVIDER_ACCOUNTS_DIR,
# and the relay's RELAY_UID/RELAY_GID. Docker socket access uses DOCKER_GID.
BOX_UID=1000
BOX_GID=1000

# Secrets
# Path to .ssh directory for git operations. Used as fallback when stacks don't set their own.
SSH_KEYS_FOLDER=
# SECRETS_DIR=/home/youruser/.carapa/secrets/box

# Separate bearer token for /api/admin/* routes. Admin access is disabled if absent or equal to the API token.
# Prefer SECRETS_DIR/carapa_box_admin_token rather than storing its value here.
# CARAPA_BOX_ADMIN_TOKEN=

# Docker socket group GID — REQUIRED for containerised mode.
# Run this to set it automatically:
#   echo "DOCKER_GID=$(stat -c '%g' /var/run/docker.sock)" >> .env
# DOCKER_GID=999

# Override egress-proxy directory path (default: ./egress-proxy)
# SANDBOX_EGRESS_PROXY_DIR=

# Optional tools — only registered when enabled
# ENABLE_SANDBOX_GIT=true           # sandbox_git: git operations via host SSH keys
# GIT_REMOTE_PIN_REQUIRED=true      # refuse keyed remote git ops that carry no remoteUrl ([SECURITY] remote URL not pinned).
#                                   # Default unset: unpinned ops still run but log '[git] unpinned remote'. Flip once the board passes remoteUrl.
# ENABLE_GIT_ISSUES=true        # sandbox_issues: GitHub/GitLab issue management
# ENABLE_SANDBOX_TMUX=true          # /api/tmux/* REST+SSE routes.
                                      # Leave UNSET (default) while tmux session lifecycle
                                      # has open interactions with agent runs — opt in only
                                      # after reproducing the bug in isolation.

# Optional for other carapa components
# CARAPA_DATA_DIR=/home/user/ai-knowledge-base
# IPC_MOUNT=/path/to/ipc    # Host path for inter-stack IPC (derived from CARAPA_DATA_DIR if unset)
# Containerised Box only: host directory containing every stack's IPC_MOUNT. It is
# mounted into Box so the sandbox_ipc / sandbox_ipc_sync tools can serve run files.
# Defaults to IPC_MOUNT; set it only when a stack .env points IPC_MOUNT elsewhere.
# CARAPA_BOX_IPC_HOST_DIR=/path/to/ipc

# Optional host-nginx integration. CarapaBox writes one generated reverse-proxy
# server block per running Compose project and reloads NGINX_PROXY_CONTAINER.
# ENABLE_NGINX_PROXY=true
# NGINX_PROXY_DIR=/home/user/docker/nginx/conf.d/carapa-generated
# NGINX_PROXY_CONTAINER=nginx_app
# NGINX_PROXY_DOMAIN=carapa.box
# NGINX_PROXY_DOMAIN2=example.com
# Optional direct ingress endpoint for containerized nginx on the ingress edge.
# Avoids source-address rewriting through Docker's published host ports.
# NGINX_PROXY_INGRESS_HOST=172.29.255.2

# Shared HTTP/SSH ingress (see docs/ingress.md). Start the Compose ingress
# profile, configure explicit source allowlists, then enable and recreate stacks.
# ENABLE_INGRESS_PROXY=true
# INGRESS_STATE_HOST_DIR=/home/youruser/.carapa-box/ingress
# INGRESS_PUBLIC_HOST=192.168.1.10
# INGRESS_HTTP_ALLOW_CIDRS=172.20.0.10/32
# INGRESS_SSH_ALLOW_CIDRS=192.168.1.0/24
# INGRESS_PUBLISH_IP=0.0.0.0
# INGRESS_EDGE_SUBNET=172.29.255.0/28
# INGRESS_EDGE_IP=172.29.255.2
# INGRESS_PORT_START=22000
# INGRESS_PORT_END=22255
# Optional Board-managed provider login (requires the directory and existing
# Box authentication). Directory must be outside every sandbox mount.
# Set the same directory in egress-proxy/.env. Use an already-built trusted image.
PROVIDER_ACCOUNTS_DIR=
PROVIDER_RELAY_CLIENTS_DIR=
PROVIDER_LOGIN_IMAGE=carapa-bot:0.1.0
# Selected volume from stacks/carapa-bot/harness.py status; must contain the login CLI.
PROVIDER_LOGIN_HARNESS_VOLUME=
PROVIDER_LOGIN_NETWORK=egress_proxy
PROVIDER_LOGIN_PROXY=http://squid:3128
# Defaults to the Box process UID/GID. Must match the directory owner and relay.
# Compose defaults to 1000:1000; see docs/provider-accounts.md before enabling.
PROVIDER_LOGIN_UID=

# Optional private installation directory (outside all sandbox mounts).
# Keep the actual .env here; a host-only .env symlink lets plain Compose find it.
# CARAPA_BOX_HOME=/home/youruser/.carapa-box
# CARAPA_BOX_ENV_FILE=/home/youruser/.carapa-box/.env
# CARAPA_BOX_CONFIG_HOST_DIR=/home/youruser/.carapa-box/config
# CARAPA_BOX_STATE_HOST_DIR=/home/youruser/.carapa-box/state
# Container Compose maps these to /app/config and /app/generated.
# Host mode uses CARAPA_BOX_HOME/config and CARAPA_BOX_HOME/state.

# Operator-only deployment: when this .env and a copy of docker-compose.yml live
# outside the checkout, point Compose back at the checkout and at private copies
# of the controller's seccomp profiles (see docs/installation-data.md).
# CARAPA_BOX_SOURCE_DIR=/home/youruser/carapa/carapa-box
# CARAPA_BOX_SECCOMP_DIR=/home/youruser/.carapa/deploy/security
# Operator-only egress Compose project (mounted at /app/egress-deploy).
# CARAPA_BOX_EGRESS_DEPLOY_DIR=/home/youruser/.carapa/deploy/egress-proxy

# ── Hub mode (multi-host) ────────────────────────────────────────────────
# Connect out to a CarapaBoard hub and serve this box's tools over that
# WebSocket. Register the box in Board (Admin → CarapaBox hosts) to obtain
# the id and the one-time connection secret. Remote hubs require wss://.
# CARAPA_HUB_URL=wss://board.example.com
# CARAPA_BOX_ID=lab-pc
# CARAPA_HUB_BOX_SECRET=            # or SECRETS_DIR/carapa_hub_box_secret
# CARAPA_BOX_ISOLATION=gvisor  # optional label shown in Board
# CARAPA_HUB_ALLOW_INSECURE=1  # only for ws:// on a trusted private network
# Roots for projects placed on this box. Board sends @group/<folder> and
# @repo/<name>; both roots must be covered by config/mount-allowlist.yaml.
# CARAPA_BOX_GROUPS_ROOT=/srv/carapa/groups
# CARAPA_BOX_REPOS_ROOT=/srv/carapa/repos

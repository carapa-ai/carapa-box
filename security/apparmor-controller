#include <tunables/global>

# AppArmor profile for CarapaBox controller container
# Applies to: carapa-box (MCP server that manages Docker Compose stacks)
#
# Purpose: Allow the controller to execute docker CLI commands, run Bun,
#          and execute lifecycle hook scripts — while blocking access to
#          sensitive system files and limiting write access.
#
# Key difference from agent profile: needs Docker socket access and
# docker/bash execution, but NO workspace write access.

profile carapabox-controller flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  #include <abstractions/nameservice>

  # ── Network ──────────────────────────────────────────────────────
  network inet stream,
  network inet dgram,
  network inet6 stream,
  network inet6 dgram,
  network unix stream,          # Docker socket communication
  network unix dgram,
  network netlink raw,          # getifaddrs / route lookups

  # ── Capabilities ────────────────────────────────────────────────
  # None required — runs as non-root with docker group membership

  # ── Deny sensitive paths (deny rules always win) ────────────────
  deny /etc/shadow rwklx,
  deny /etc/gshadow rwklx,
  deny /etc/sudoers rwklx,
  deny /etc/sudoers.d/** rwklx,
  deny /proc/*/environ r,
  deny /proc/sysrq-trigger rwklx,
  deny /proc/sys/** w,
  deny /proc/kcore rwklx,
  deny /proc/kmsg rwklx,
  deny /sys/** w,
  /sys/fs/cgroup/** r,           # Bun reads cgroup memory limits
  deny /root/** rwklx,
  deny /dev/sd* rwklx,
  deny /dev/nvme* rwklx,
  deny /dev/xvd* rwklx,
  deny /dev/vd* rwklx,
  deny mount,

  # ── Docker socket (read-write) ─────────────────────────────────
  /var/run/docker.sock rw,
  /run/docker.sock rw,

  # ── Application (read-only + execute) ──────────────────────────
  / r,                           # Bun reads root directory on startup
  /app/ r,
  /app/** r,
  /app/dist/** mrix,             # Bundled JS — Bun needs mmap exec

  # ── Generated output (writable bind mount) ────────────────────
  /app/generated/** rw,

  # Atomically publish IP reservations without replacing a concurrent writer.
  link subset /app/generated/network-reservations/agent_egress_*.json -> /app/generated/network-reservations/agent_egress_*.json.*.tmp,

  # Private ingress state: route snapshots, resolved Compose models and intents.
  /app/ingress/ rw,
  /app/ingress/** rw,
  link subset /app/ingress/ports/*.json -> /app/ingress/ports/*.json.*.tmp,

  # Private provider login profiles and atomic credential installation.
  /app/provider-accounts/ rw,
  /app/provider-accounts/** rwk,

  # Box-owned sandbox IPC trees and hub-placed group directories, served to
  # Board by sandbox_ipc / sandbox_ipc_sync and the group tools.
  /app/ipc/ rw,
  /app/ipc/** rwk,
  /app/groups/ rw,
  /app/groups/** rwk,

  # ── Audit log (writable bind mount) ───────────────────────────
  # docker-compose mounts generated/audit here for persistent host logs.
  /var/log/carapabox/** rw,

  # ── Stacks & security (read-only bind mounts) ─────────────────
  # These are mounted from the host as :ro
  /app/stacks/** r,
  /app/security/** r,
  /app/images/** r,
  /app/.env r,

  # ── Managed services (read-only bind mounts) ────────────────
  # Mounted at host path so docker compose can read YAML files.
  # Directory entries must be statable for docker build context.
  /home/**/carapa-board/ r,
  /home/**/carapa-board/** r,

  # ── System binaries & libraries (read + execute + mmap exec) ──
  /usr/** mrix,
  /lib/** mrix,
  /lib64/** mrix,
  /bin/** mrix,
  /sbin/** mrix,
  /opt/bun/** mrix,              # Bun runtime

  # ── System config (read-only) ─────────────────────────────────
  /etc/passwd r,
  /etc/group r,
  /etc/hosts r,
  /etc/resolv.conf r,
  /etc/host.conf r,
  /etc/nsswitch.conf r,
  /etc/ssl/** r,
  /etc/ca-certificates/** r,
  /etc/ld.so.cache r,
  /etc/ld.so.conf r,
  /etc/ld.so.conf.d/** r,
  /etc/localtime r,
  /etc/timezone r,
  /etc/bash.bashrc r,
  /etc/profile r,
  /etc/profile.d/ r,
  /etc/profile.d/** r,
  /etc/inputrc r,
  /etc/terminfo/** r,
  /etc/alternatives/** r,

  # ── Temp & runtime (writable tmpfs) ────────────────────────────
  /tmp/** rwkmix,
  /run/** rw,
  /app/.bun/** rwkmix,

  # ── Device access ──────────────────────────────────────────────
  /dev/null rw,
  /dev/zero r,
  /dev/full rw,
  /dev/random r,
  /dev/urandom r,
  /dev/tty rw,
  /dev/console rw,
  /dev/pts/* rw,
  /dev/ptmx rw,
  /dev/shm/** rwm,
  /dev/fd/** rw,

  # ── Proc (filtered) ───────────────────────────────────────────
  /proc/ r,
  /proc/sys/kernel/random/uuid r,
  /proc/sys/kernel/hostname r,
  /proc/sys/kernel/osrelease r,
  /proc/sys/kernel/ngroups_max r,
  /proc/sys/vm/overcommit_memory r,
  /proc/sys/vm/mmap_min_addr r,
  /proc/sys/net/** r,
  /proc/self/** r,
  /proc/tty/drivers r,
  /proc/[0-9]*/cmdline r,
  /proc/[0-9]*/stat r,
  /proc/[0-9]*/statm r,
  /proc/[0-9]*/mem r,
  /proc/[0-9]*/status r,
  /proc/[0-9]*/fd/** rw,
  /proc/[0-9]*/fdinfo/** r,
  /proc/[0-9]*/maps r,
  /proc/[0-9]*/mounts r,
  /proc/[0-9]*/mountinfo r,
  /proc/[0-9]*/net/** r,
  /proc/[0-9]*/task/** r,
  /proc/[0-9]*/cgroup r,
  /proc/meminfo r,
  /proc/cpuinfo r,
  /proc/filesystems r,
  /proc/stat r,
  /proc/loadavg r,
  /proc/uptime r,
  /proc/version r,

  # ── Signal handling ────────────────────────────────────────────
  signal,
  ptrace read peer=carapabox-controller,
}

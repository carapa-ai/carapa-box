#include <tunables/global>

# AppArmor profile for CarapaBox agent containers
# Applies to: php84, carapa-bot/agent, openclaw/sandbox, example/sandbox,
#              carapamail, carapawalink, playwright
#
# Purpose: Allow agents to read/write workspaces, execute CLI tools,
#          and access network via egress proxy — while blocking access
#          to sensitive system files and host resources.

profile carapabox-agent flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  #include <abstractions/nameservice>

  # ── Network ──────────────────────────────────────────────────────
  network inet stream,
  network inet dgram,
  network inet6 stream,
  network inet6 dgram,
  network unix stream,
  network unix dgram,
  network netlink raw,       # needed for getifaddrs / route lookups

  # ── Capabilities ────────────────────────────────────────────────
  capability chown,
  capability setuid,
  capability setgid,
  capability fowner,
  capability fsetid,
  capability dac_override,
  capability sys_admin,      # playwright/Chromium sandbox (clone/unshare)

  # ── Deny sensitive paths (before allows — deny rules always win) ─
  deny /etc/shadow rwklx,
  deny /etc/gshadow rwklx,
  deny /etc/sudoers rwklx,
  deny /etc/sudoers.d/** rwklx,
  deny /proc/*/environ r,
  deny /proc/sysrq-trigger rwklx,
  deny /proc/sys/** w,
  deny /proc/kcore rwklx,
  deny /proc/kmsg rwklx,
  deny /sys/** w,
  /sys/fs/cgroup/** r,         # Bun reads cgroup memory limits
  /sys/devices/** r,           # Chromium headless: GPU/CPU topology probing
  /sys/class/** r,             # Chromium headless: device class enumeration
  /sys/bus/** r,               # Chromium headless: PCI bus scanning
  /sys/kernel/mm/transparent_hugepage/enabled r,  # ripgrep (rg) checks THP
  deny /root/** rwklx,
  deny /dev/sd* rwklx,
  deny /dev/nvme* rwklx,
  deny /dev/xvd* rwklx,
  deny /dev/vd* rwklx,
  deny mount,

  # ── Workspaces (read-write) ─────────────────────────────────────
  /workspace/ r,
  /workspace/** rwixkl,         # k=lock (git index.lock), l=link (git atomic ref updates)
  /var/www/ r,
  /var/www/** rwklmix,           # k=lock, l=link, m=mmap-exec, ix=exec (node_modules binaries like esbuild)
  /home/ubuntu/** rwk,
  / rw,                  # Bun reads root dir; php-fpm needs mmap write on /
  /app/ r,               # Bun reads the app directory itself (not just contents)
  /app/** rwklm,         # k=lock (SQLite WAL), l=link (atomic rename), m=mmap-exec (Bun JIT)

  # ── Read-only mounts ────────────────────────────────────────────
  /opt/** r,
  /opt/carapa-harness-store/** mrix, # versioned read-only harness releases
  /opt/agents/bin/** rix,    # npm-based AI agents (PHP stack custom prefix)
  /opt/agents/lib/** mrix,   # agent node_modules (exec for cli.js shebangs, mmap for require)
  /opt/bun/bin/bun mrix,     # Bun runtime (Alpine install at /opt/bun/)
  
  # ── System binaries & libraries (read + inherit exec + mmap exec) ─
  /usr/** mrix,
  /lib/** mrix,
  /lib64/** mrix,
  /bin/** mrix,
  /sbin/** mrix,
  /usr/local/ai-cli-bin/** mrix,
  /usr/local/stack-cli-bin/** mrix,

  # ── System config (read-only) ───────────────────────────────────
  /etc/passwd r,
  /etc/group r,
  /etc/hosts r,
  /etc/resolv.conf r,
  /etc/host.conf r,
  /etc/nsswitch.conf r,
  /etc/ssl/** r,
  /etc/ca-certificates/** r,
  /etc/ld.so.cache r,
  /etc/ld.so.conf r,
  /etc/ld.so.conf.d/** r,
  /etc/localtime r,
  /etc/timezone r,
  /etc/mime.types r,
  /etc/bash.bashrc r,
  /etc/bash/ r,
  /etc/bash/** r,
  /etc/profile r,
  /etc/profile.d/ r,
  /etc/profile.d/** r,
  /etc/inputrc r,
  /etc/terminfo/** r,
  /etc/alternatives/** r,
  /etc/dpkg/** r,
  /etc/apt/** r,
  /etc/php/** r,
  /etc/php82/** r,
  /etc/php83/** r,
  /etc/php84/** r,
  /etc/php85/** r,
  /etc/nginx/** r,
  /etc/my.cnf r,
  /etc/my.cnf.d/** r,
  /etc/mysql/** r,
  /etc/wgetrc r,               # wget config (used by health checks / downloads)
  /etc/chromium/ r,            # Chromium: config directory
  /etc/chromium/** r,          # Chromium: config files
  /etc/fonts/** r,             # Chromium: font configuration
  /var/cache/fontconfig/** r,  # Chromium: font cache

  # ── Temp & runtime ─────────────────────────────────────────────
  /tmp/** rwkmix,
  /run/** rw,
  /var/tmp/** rwm,

  # ── Device access ──────────────────────────────────────────────
  /dev/null rw,
  /dev/zero r,
  /dev/full rw,
  /dev/random r,
  /dev/urandom r,
  /dev/tty rw,
  /dev/console rw,
  /dev/pts/* rw,
  /dev/ptmx rw,
  /dev/shm/** rwm,
  /dev/mqueue/** rw,
  /dev/fd/** rw,

  # ── Proc (filtered) ───────────────────────────────────────────
  /proc/ r,
  /proc/sys/kernel/random/uuid r,
  /proc/sys/kernel/hostname r,
  /proc/sys/kernel/osrelease r,
  /proc/sys/kernel/ngroups_max r,
  /proc/sys/vm/overcommit_memory r,
  /proc/sys/vm/mmap_min_addr r,   # Bun checks mmap lower bound
  /proc/sys/net/** r,
  /proc/self/** r,
  /proc/tty/drivers r,        # pgrep needs this for terminal detection
  /proc/[0-9]*/cmdline r,     # pgrep reads cmdline to match process names
  /proc/[0-9]*/stat r,
  /proc/[0-9]*/statm r,         # Bun reads memory stats
  /proc/[0-9]*/mem r,           # Bun reads own process memory
  /proc/[0-9]*/status r,
  /proc/[0-9]*/fd/ r,         # Chromium: list open file descriptors
  /proc/[0-9]*/fd/** rw,
  /proc/[0-9]*/fdinfo/** r,
  /proc/[0-9]*/maps r,
  /proc/[0-9]*/mounts r,
  /proc/[0-9]*/mountinfo r,
  /proc/[0-9]*/net/** r,
  /proc/[0-9]*/oom_score_adj rw,
  /proc/[0-9]*/task/** r,
  /proc/[0-9]*/cgroup r,
  /proc/meminfo r,
  /proc/cpuinfo r,
  /proc/filesystems r,
  /proc/stat r,
  /proc/loadavg r,
  /proc/uptime r,
  /proc/version r,
  /proc/version_signature r,   # Chromium reads kernel version signature
  /proc/sys/fs/nr_open r,      # Chromium: max open file descriptors
  /proc/sys/fs/inotify/max_user_watches r,  # Chromium: inotify limits

  # ── Logging ────────────────────────────────────────────────────
  /var/log/** rw,

  # ── Signal handling ────────────────────────────────────────────
  signal,
  ptrace read peer=carapabox-agent,
}

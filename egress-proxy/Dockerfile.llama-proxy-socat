# ── Hardened LLM TCP forwarder ───────────────────────────────────────────
# Multi-stage build: installs socat in a full Alpine image, then copies
# just the binary and its shared libraries into the DHI alpine-base.
#
# Security items addressed: #4 (DHI), #5 (digest pin), #6 (CVE scan), #7 (minimal pkgs)

# ── Build stage — full Alpine with apk ──────────────────────────────────
FROM alpine:3.23 AS build

# socat — TCP forwarding (core service)
RUN apk add --no-cache socat

# Collect socat and its shared library dependencies
RUN mkdir -p /deps/usr/bin /deps/usr/lib && \
    cp /usr/bin/socat /deps/usr/bin/ && \
    for lib in $(ldd /usr/bin/socat 2>/dev/null | awk '/=>/{print $3}'); do \
      cp "$lib" /deps/usr/lib/ 2>/dev/null || true; \
    done

# ── Runtime stage — DHI distroless Alpine ───────────────────────────────
# dhi.io/alpine-base:3.23 — pinned 2026-11-21
FROM dhi.io/alpine-base:3.23@sha256:8a14cb527704fd6325fae6e92e0bc73a3c64b44a83c36a3abb53730c5757cc72

LABEL org.opencontainers.image.title="egress-proxy-llama-proxy" \
      org.opencontainers.image.description="TCP forwarder for local LLM runners (Ollama/LiteLLM)" \
      org.opencontainers.image.version="1.0.0"

# Copy socat binary and its runtime libraries from build
COPY --from=build /deps/usr/bin/socat /usr/bin/socat
COPY --from=build /deps/usr/lib/ /usr/lib/

# Non-root user — numeric UID (no adduser in distroless base)
USER 65532:65532

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD socat -u OPEN:/dev/null TCP:127.0.0.1:11434,connect-timeout=2 2>/dev/null || exit 1

EXPOSE 8880 11434

ENTRYPOINT ["sh", "-c"]
CMD ["socat TCP-LISTEN:${LLAMA_PORT:-8880},fork,reuseaddr TCP:host.docker.internal:${LLAMA_PORT:-8880} & socat TCP-LISTEN:11434,fork,reuseaddr TCP:host.docker.internal:11434 & wait"]

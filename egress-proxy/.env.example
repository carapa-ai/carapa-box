# ── Egress proxy domain allowlist ──────────────────────────────────────────
# Agent containers run on internal networks (no direct internet).
# Only domains in the YAML policy files are reachable via Squid.
#
# Base domains (all stacks):  config/policies/network-base.yaml
# Per-stack domains:          stacks/{name}/network-policy.yaml
#
# Changes are hot-reloaded (~2s). Per-stack isolation enforced via src ACLs.
# Generated config: generated/squid-generated.conf
#
# Host services (host.docker.internal):
#   Containers can reach services on the Docker host, but only on:
#     - 3000-9999  (dev servers, APIs, local LLM proxies)
#     - 11434      (Ollama default port)

# ── API credential relay ──────────────────────────────────────────────────
# Keys injected by api-relay. Agent containers never see these.
# Only set providers you use.
#
# Static API keys — two options (file-based secrets preferred):
#
# Option A: File-based secrets (recommended)
#   Write each key to secrets/<name>, e.g.:
#     echo "sk-ant-..." > secrets/anthropic_api_key
#   The relay reads /run/secrets/<name> first, falls back to env vars.
#   Secrets are mounted as tmpfs — invisible in docker inspect and /proc/*/environ.
#
# Option B: Environment variables (supported alternative; file secrets are preferred):
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=AIza...
#
# OAuth credentials (Claude, Codex/ChatGPT, Antigravity):
# Connect accounts in CarapaBoard -> Provider accounts and set the same
# PROVIDER_ACCOUNTS_DIR here and in CarapaBox's .env (docs/provider-accounts.md).
# One scheduler checks default and per-client credentials every minute.
# Claude refreshes within 30 minutes of expiry; Codex within 5 minutes.
# HTTP/SSE and WebSocket handshakes also renew and retry once on 401.
# Optional, relay-only storage for independently authenticated client accounts:
# OAUTH_CLIENT_CREDENTIALS_DIR=/path/outside/agent-homes/oauth-clients
# Mounts at /app/credentials/clients; configure each exact file in relay-clients/.
# Required for any isolation:"strict" client profile. When enabled, ALL clients
# need exact container-name matches; wildcard matches/default-only callers fail.
# RELAY_REQUIRE_KNOWN_CLIENTS=1
#
# Note: Gemini OAuth cannot go through the relay (CLI hardcodes cloudcode-pa.googleapis.com
# and token scopes don't match generativelanguage.googleapis.com). Use API key or OAuth direct.
#
# OAuth takes priority over static keys when both are set.
# SECRETS_DIR=/home/youruser/.carapa/secrets/box

# ── Rate limiting ──────────────────────────────────────────────────────────
# api-relay enforces per-client and global rate limits on all forwarded requests.
# Defaults are generous — tune down for tighter control.
#
# RATE_LIMIT_PER_CLIENT=60    # max requests per client per provider per window
# RATE_LIMIT_GLOBAL=300       # max requests per provider per window (all clients)
# RATE_LIMIT_WINDOW_S=60      # sliding window size in seconds

# ── Upstream timeouts ──────────────────────────────────────────────────────
# Bound how long a forwarded request may hang. A squid reconfigure can sever an
# in-flight CONNECT tunnel silently; without these the request would hang until
# the board's stall watchdog kills the whole agent run. The idle timer resets on
# every byte (incl. SSE keepalives), so a live stream never trips it.
#
# RELAY_UPSTREAM_CONNECT_TIMEOUT_MS=30000   # max wait to establish the CONNECT tunnel
# RELAY_UPSTREAM_IDLE_TIMEOUT_MS=120000     # max gap with no bytes on an open tunnel


RELAY_UID=1000
RELAY_GID=1000

# ── Carapa ────────────────────────────────────────────────────────────────
CARAPA_BOX_API_TOKEN=

# ── Github/GitLab ──────────────────────────────────────────────────────────
GITLAB_HOST_URL=
GITLAB_PAT=
# Optional Board-managed OAuth accounts. Same absolute host path as CarapaBox;
# never place this under AGENT_HOME or a sandbox workspace mount.
PROVIDER_ACCOUNTS_DIR=

# Match the controller state directory when using a private installation.
# CARAPA_BOX_STATE_HOST_DIR=/home/youruser/.carapa-box/state

# Operator-only deployment (docs/installation-data.md): when this .env and a
# copy of docker-compose.yml live outside the checkout, point Compose at the
# checkout's egress-proxy (build contexts, live service code) and at the
# private directory (squid.conf, squid-entrypoint.sh, tool_profiles.jsonc).
# EGRESS_SOURCE_DIR=/home/youruser/carapa/carapa-box/egress-proxy
# EGRESS_CONFIG_DIR=/home/youruser/.carapa/deploy/egress-proxy

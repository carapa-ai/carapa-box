AGENT_HOME=
# Path to .ssh directory for git operations. Overrides the root .env value for this stack.
SSH_KEYS_FOLDER=
CARAPABOT_DIR=
LOCAL_REPO=
WORKSPACE_PATH=/workspace/project
GROUP_DIR=
IPC_MOUNT=
MEMORY_PROJECT=

# Public runtime. Use your Docker Hub namespace when pulling a published build.
CARAPA_BOT_IMAGE=carapa-bot:0.1.0
# Install explicitly: python3 harness.py install codex (or claude, pi, etc.).
# Harnesses are never installed by build.sh or container startup.
# Optional docker-compose.ca.yml override (enable both lines):
# COMPOSE_FILE=docker-compose.yml:docker-compose.ca.yml
# CARAPA_CA_CERTIFICATE=/absolute/host/path/root.crt

# Network: agent uses the shared agent_egress network (internal, no direct internet).
# Egress proxy config and allowed domains are in egress-proxy/.

# Antigravity SDK and ACP API-key mode use api-relay, not sandbox credentials.
# Compose supplies a dummy GEMINI_API_KEY and GOOGLE_GEMINI_BASE_URL=/google on
# the relay. Put the real key in the relay's ${SECRETS_DIR}/google_api_key (or its
# configured per-client Google credential). No Gemini secret is mounted here.
# Neither API-key harness uses ~/.gemini/oauth_creds.json.

# antigravity-acp run args.env (not automatically injected by stack .env):
# ANTIGRAVITY_ACP_AUTH_METHOD=gemini-api-key  # default; or oauth-personal
# ANTIGRAVITY_ACP_HOME=/home/ubuntu/.gemini-carapa-acp-account
# OAuth is a separate, non-relayed opt-in mode; it requires a pre-authenticated
# profile (its antigravity-cli/ folder) inside the sandbox.
# No browser sign-in flow is launched by ordinary runs.
# Optional externally installed Antigravity CLI executable:
# ANTIGRAVITY_ACP_BIN=/path/to/antigravity

# Shared browser: set to 1 to run Chromium headed on a virtual display (Xvfb)
# instead of headless, so a human in the Browser tab can pass bot checks such as
# Cloudflare Turnstile. Unset keeps headless. See docs/browser-viewer.md.
# CARAPA_BROWSER_HEADED=1

#!/usr/bin/env node
'use strict';
// On-demand browsing uses the same CLI shim as agent commands. The controller
// selects a descriptor, never a command, CDP endpoint, or viewer upstream URL.
const fs = require('node:fs');
const path = require('node:path');
const { spawnSync } = require('node:child_process');
const { readBrowser, browserIsOpen, commandError } = require('./browser-session.cjs');
const { startApp } = require('./browser-app.cjs');
const { nativeRoots, hostEnvValue } = require('./browser-host.cjs');
const { localLaunch } = require('./browser-xvfb.cjs');
// A native runner (Mac) has no local Chromium and no container app: it drives
// the hub's browser through the relay and opens external URLs only.
const native = nativeRoots();
const loopback = /^(localhost|.*\.localhost|127(\.\d{1,3}){3}|\[::1\]|0\.0\.0\.0|nginx)$/;
const localPreview = url => {
  try { return loopback.test(new URL(url).hostname.toLowerCase().replace(/\.+$/, '')); } catch { return false; }
};
try {
  const [id, action] = process.argv.slice(2);
  if (process.argv.length !== 4 || !['start', 'restart'].includes(action)) throw new Error('Usage: browser-open <sessionId> <start|restart>');
  const { env, cwd, descriptor } = readBrowser(id);
  if (!descriptor) throw new Error('On-demand browsing requires a persistent context');
  const run = (name, args) => {
    const result = spawnSync(process.execPath, [path.join(__dirname, name), ...args], { env, cwd, encoding: 'utf8', timeout: 45_000, maxBuffer: 1024 * 1024 });
    if (result.status !== 0 || result.stdout?.includes('### Error')) throw commandError(result, name);
  };
  if (native && (!descriptor.requestedUrl || localPreview(descriptor.requestedUrl))) {
    throw new Error('Previews of apps running on the Mac are not supported yet; open an external URL');
  }
  let cdpEndpoint;
  if (native) {
    // Board's web_view variable: the hub browser behind the relay's CDP gateway.
    const endpoint = descriptor.env?.PLAYWRIGHT_MCP_CDP_ENDPOINT;
    if (typeof endpoint !== 'string' || !endpoint) throw new Error('Board did not provide a remote browser for this Mac project');
    cdpEndpoint = env.PLAYWRIGHT_MCP_CDP_ENDPOINT = hostEnvValue(endpoint);
  }
  if (action === 'restart') run('browser-close', [id]);
  const open = browserIsOpen(env, cwd);
  let url = descriptor.requestedUrl;
  if (!url) {
    const preview = path.join(cwd, '.preview-url');
    let appStarted = false;
    if (fs.existsSync(preview)) url = fs.readFileSync(preview, 'utf8').trim();
    else {
      const app = startApp(env, cwd);
      url = app?.url;
      appStarted = !!app?.started;
    }
    // Repeated Start keeps the current page, cookies and tabs. A managed hook
    // has still been checked/restarted if its app process stopped meanwhile.
    if (open && !appStarted) process.exit(0);
    // Only PHP-style stacks have an nginx sidecar; elsewhere a missing hook
    // (often a call from a subfolder) must fail instead of opening a dead page.
    if (!url) {
      const nginx = spawnSync(process.execPath, ['-e', "require('dns').lookup('nginx', e => process.exit(e ? 1 : 0))"], { timeout: 5000 });
      if (nginx.status !== 0) throw new Error(`No project preview in ${cwd}: expected .agent/start-browser.sh or .preview-url there (run from the checkout root)`);
      url = 'http://nginx/';
    }
  }
  const parsed = new URL(url);
  if (url.length > 4096 || !['http:', 'https:'].includes(parsed.protocol) && url !== 'about:blank' || parsed.username || parsed.password) throw new Error('Invalid app URL');
  const root = env.PLAYWRIGHT_DAEMON_SESSION_DIR;
  fs.mkdirSync(root, { recursive: true });
  const config = path.join(root, 'board-browser.json');
  const local = native ? undefined : localLaunch();
  if (local?.display) env.DISPLAY = local.display;
  fs.writeFileSync(config, JSON.stringify({ browser: { browserName: 'chromium', ...(native ? { cdpEndpoint } : { launchOptions: local.launchOptions }) } }), { mode: 0o600 });
  run('playwright-cli', ['open', url, `--config=${config}`]);
  console.log('Shared browser ready');
} catch (error) {
  process.stderr.write(`browser-open: ${error.message}\n`);
  process.exitCode = 1;
}

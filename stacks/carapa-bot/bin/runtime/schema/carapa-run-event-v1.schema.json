{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carapa.ai/schema/carapa-run-event-v1.schema.json",
  "title": "CarapaRunEventV1",
  "description": "Compact semantic events emitted to output.v1.jsonl by every CarapaBot harness runtime.",
  "oneOf": [
    { "$ref": "#/$defs/session" },
    { "$ref": "#/$defs/run" },
    { "$ref": "#/$defs/messageDelta" },
    { "$ref": "#/$defs/message" },
    { "$ref": "#/$defs/thoughtDelta" },
    { "$ref": "#/$defs/thought" },
    { "$ref": "#/$defs/toolCall" },
    { "$ref": "#/$defs/interaction" },
    { "$ref": "#/$defs/plan" },
    { "$ref": "#/$defs/usage" },
    { "$ref": "#/$defs/errorEvent" }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message"],
      "properties": {
        "message": {
          "type": "string"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "details": {}
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "status"],
      "properties": {
        "type": {
          "const": "session"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": ["started", "resumed"]
        }
      }
    },
    "runMetrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "timeToFirstOutputMs": {
          "type": "integer",
          "minimum": 0
        },
        "costUsd": {
          "type": "number",
          "minimum": 0
        },
        "contextSize": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "status"],
      "properties": {
        "type": {
          "const": "run"
        },
        "status": {
          "enum": ["started", "in_progress", "completed", "interrupted", "failed"]
        },
        "model": {
          "description": "The model selected for this run state. A later in_progress value is the effective provider model and supersedes the requested model for consumers.",
          "type": "string",
          "minLength": 1
        },
        "reasoningEffort": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "stopReason": {
          "type": "string"
        },
        "error": {
          "$ref": "#/$defs/error"
        },
        "metrics": {
          "$ref": "#/$defs/runMetrics"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "error": {
                "$ref": "#/$defs/error"
              }
            },
            "required": ["error"]
          }
        }
      ]
    },
    "role": {
      "enum": ["user", "assistant", "system"]
    },
    "messageDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "role", "delta"],
      "properties": {
        "type": {
          "const": "message_delta"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "enum": ["assistant", "system"]
        },
        "delta": {
          "type": "string"
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "role", "content", "status"],
      "properties": {
        "type": {
          "const": "message"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "content": {
          "type": "string"
        },
        "format": {
          "enum": ["markdown", "text"]
        },
        "status": {
          "enum": ["completed", "interrupted"]
        }
      }
    },
    "thoughtDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "delta"],
      "properties": {
        "type": {
          "const": "thought_delta"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "delta": {
          "type": "string"
        }
      }
    },
    "thought": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "content", "status"],
      "properties": {
        "type": {
          "const": "thought"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "content": {
          "type": "string"
        },
        "format": {
          "enum": ["markdown", "text"]
        },
        "status": {
          "enum": ["completed", "interrupted"]
        }
      }
    },
    "toolCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "status"],
      "properties": {
        "type": {
          "const": "tool_call"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": ["started", "in_progress", "completed", "failed"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": ["execute", "read", "edit", "search", "mcp", "other"]
        },
        "input": {},
        "outputDelta": {},
        "output": {},
        "exitCode": {
          "type": ["integer", "null"]
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "started"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["name"]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "error": {
                "$ref": "#/$defs/error"
              }
            },
            "required": ["error"]
          }
        }
      ]
    },
    "interactionOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "description"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "preview": {
          "type": "string"
        }
      }
    },
    "interactionQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "header", "question"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "header": {
          "type": "string"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interactionOption"
          }
        },
        "allowOther": {
          "type": "boolean"
        },
        "secret": {
          "type": "boolean"
        },
        "multiSelect": {
          "type": "boolean"
        }
      }
    },
    "answers": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/interactionQuestion"
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "status"],
      "properties": {
        "type": {
          "const": "interaction"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": ["requested", "answered", "cancelled"]
        },
        "questions": {
          "$ref": "#/$defs/questions"
        },
        "answers": {
          "$ref": "#/$defs/answers"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "requested"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "questions": {
                "$ref": "#/$defs/questions"
              }
            },
            "required": ["questions"]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "answered"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "answers": {
                "$ref": "#/$defs/answers"
              }
            },
            "required": ["answers"]
          }
        }
      ]
    },
    "planEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "content", "status"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "content": {
          "type": "string"
        },
        "status": {
          "enum": ["pending", "in_progress", "completed"]
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "entries"],
      "properties": {
        "type": {
          "const": "plan"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/planEntry"
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "scope", "inputTokens", "outputTokens"],
      "properties": {
        "type": {
          "const": "usage"
        },
        "scope": {
          "enum": ["incremental", "cumulative"]
        },
        "inputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "cachedInputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "cacheWriteInputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "reasoningOutputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "cacheTtlSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "errorEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "message", "fatal"],
      "properties": {
        "type": {
          "const": "error"
        },
        "message": {
          "type": "string"
        },
        "fatal": {
          "type": "boolean"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "details": {}
      }
    }
  }
}

#!/bin/sh
# Keep CarapaBoard from restarting this sandbox automatically (newer image,
# restart-when-idle, mount changes) while a long-running process finishes.
#
#   restart-hold run NAME CMD [ARGS...]  run CMD; the hold ends when CMD exits
#   restart-hold set NAME [PID]          hold while PID runs, or until cleared
#   restart-hold clear NAME              remove a hold
#   restart-hold status                  list active holds
#
# A hold is a file in /tmp/carapa-restart-hold. One holding a PID ends by
# itself when that process exits; one without a PID lasts until cleared.
# Use `set NAME` + `clear NAME` for a command that daemonizes, since `run`
# follows only the process it starts. A restart a user asks for still runs.
# CarapaBoard reads the last line of `status` (restart_holds=N).

set -eu

HOLD_DIR=/tmp/carapa-restart-hold

usage() {
  sed -n '5,8s/^# *//p' "$0" >&2
  exit 2
}

check_name() {
  case "$1" in
    ''|*/*|.*)
      echo "restart-hold: NAME must be a plain file name" >&2
      exit 2
      ;;
  esac
}

action="${1:-}"
[ $# -gt 0 ] && shift

case "$action" in
  run)
    [ $# -ge 2 ] || usage
    check_name "$1"
    name=$1
    shift
    mkdir -p "$HOLD_DIR"
    # exec keeps this PID, so the hold follows CMD itself.
    echo $$ > "$HOLD_DIR/$name"
    exec "$@"
    ;;
  set)
    [ $# -ge 1 ] && [ $# -le 2 ] || usage
    check_name "$1"
    pid="${2:-}"
    case "$pid" in
      *[!0-9]*)
        echo "restart-hold: PID must be a positive integer" >&2
        exit 2
        ;;
    esac
    mkdir -p "$HOLD_DIR"
    echo "$pid" > "$HOLD_DIR/$1"
    ;;
  clear)
    [ $# -eq 1 ] || usage
    check_name "$1"
    rm -f "$HOLD_DIR/$1"
    ;;
  status)
    [ $# -eq 0 ] || usage
    n=0
    for f in "$HOLD_DIR"/*; do
      [ -f "$f" ] || continue
      pid=
      read -r pid _ < "$f" || true
      case "$pid" in
        ''|*[!0-9]*)
          echo "${f##*/}: until cleared"
          ;;
        *)
          # /proc instead of kill -0: works whichever user owns the process.
          if [ ! -d "/proc/$pid" ]; then
            rm -f "$f"
            continue
          fi
          echo "${f##*/}: while PID $pid runs"
          ;;
      esac
      n=$((n + 1))
    done
    echo "restart_holds=$n"
    ;;
  *)
    usage
    ;;
esac
